{
    "version": 1,
    "disable_existing_loggers": false,
    "formatters": {
        "standard": {
            "format": "{asctime} {name:^15} [{levelname:^8}] {filename}:{lineno} {message}",
            "style": "{"
        }
    },
    "handlers": {
        "file": {
            "class": "logging.FileHandler",
            "formatter": "standard",
            "filename": "history.log"
        },
        "console":{
            "class": "logging.StreamHandler",
            "formatter": "standard",
            "stream": "ext://sys.stdout"
        }
    },
     "root": {"level": "ERROR", "handlers": ["file", "console"]},
    "loggers": {
        "make_sense": {"level": "INFO"},
        "marker": {"level": "WARNING", "handlers": []}
    }
}